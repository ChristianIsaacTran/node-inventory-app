<% if(validationErr === true) { %>
    <head>
        <link rel="stylesheet" href="/updateError.css">
    </head>
    <div class="error-container">
        <h2>Form Error: </h2>
        <ul class="error-list">
            <%validationArr.forEach((error) => { %>
                <li><%= error.msg %></li>
            <% });%>
        </ul>
    </div>
<% } %>