<head>
    <link rel="stylesheet" href="/createForm.css">
</head>
<form action="/create/weapon?formType=<%=formType%>" method="post" class="weapon-form">
        <label class="amount-label" for="amount">Amount: </label>
        <input type="number" id="amount" name="amount" value="<%= prevInput ? prevInput.amount : "" %>" min="0">
        <label class="item-name-label" for="item-name ">Item name: </label>
        <input id="item-name" type="text" name="itemName" value="<%= prevInput ? prevInput.itemName : "" %>">
        <label class="item-category-label" for="item-category ">Item category: </label>
        <select id="item-category" name="itemCategory" >
            <option value="assault rifle" <%= prevInput ? (prevInput.itemCategory === "assault rifle" ? "selected" : "") : ""%> >Assault Rifle</option>
            <option value="shotgun" <%= prevInput ? (prevInput.itemCategory === "shotgun" ? "selected" : "") : ""%>>Shotgun</option>
            <option value="submachine gun" <%= prevInput ? (prevInput.itemCategory === "submachine gun" ? "selected" : "") : ""%>>Submachine Gun</option>
            <option value="pistol" <%= prevInput ? (prevInput.itemCategory === "pistol" ? "selected" : "") : ""%>>Pistol</option>
            <option value="sniper rifle" <%= prevInput ? (prevInput.itemCategory === "sniper rifle" ? "selected" : "") : ""%>>Sniper Rifle</option>
            <option value="marksman rifle" <%= prevInput ? (prevInput.itemCategory === "marksman rifle" ? "selected" : "") : ""%>>Marksman Rifle</option>
            <option value="explosive weapon" <%= prevInput ? (prevInput.itemCategory === "explosive weapon" ? "selected" : "") : ""%>>Explosive Weapon</option>
            <option value="special weapon" <%= prevInput ? (prevInput.itemCategory === "special weapon" ? "selected" : "") : ""%>>Special Weapon</option>
        </select>
        <label class="item-rarity-label" for="item-rarity">Item rarity: </label>
        <select id="item-rarity" name="itemRarity" >
            <option value="common" <%= prevInput ? (prevInput.itemRarity === "common" ? "selected" : "") : "" %> >Common</option>
            <option value="uncommon" <%= prevInput ? (prevInput.itemRarity === "uncommon" ? "selected" : "") : "" %>>Uncommon</option>
            <option value="rare" <%= prevInput ? (prevInput.itemRarity === "rare" ? "selected" : "") : "" %>>Rare</option>
            <option value="epic" <%= prevInput ? (prevInput.itemRarity === "epic" ? "selected" : "") : "" %>>Epic</option>
            <option value="legendary" <%= prevInput ? (prevInput.itemRarity === "legendary" ? "selected" : "") : "" %>>Legendary</option>
            <option value="mythic" <%= prevInput ? (prevInput.itemRarity === "mythic" ? "selected" : "") : "" %>>Mythic</option>
            <option value="exotic"<%= prevInput ? (prevInput.itemRarity === "exotic" ? "selected" : "") : "" %>>Exotic</option>
        </select>
        <label class="bullet-type-label" for="bullet-type">Bullet Type: </label>
        <select id="bullet-type" name="bulletType" >
            <option value="light bullets" <%= prevInput ? (prevInput.bulletType === "light bullets" ? "selected" : "") : "" %>>Light Bullets</option>
            <option value="medium bullets"  <%= prevInput ? (prevInput.bulletType === "medium bullets" ? "selected" : "") : "" %>>Medium Bullets</option>
            <option value="heavy bullets"  <%= prevInput ? (prevInput.bulletType === "heavy bullets" ? "selected" : "") : "" %>>Heavy Bullets</option>
            <option value="shells"  <%= prevInput ? (prevInput.bulletType === "shells" ? "selected" : "") : "" %>>Shells</option>
            <option value="rockets"  <%= prevInput ? (prevInput.bulletType === "rockets" ? "selected" : "") : "" %>>Rockets</option>
            <option value="arrows"  <%= prevInput ? (prevInput.bulletType === "arrows" ? "selected" : "") : "" %>>Arrows</option>
            <option value="grenade"  <%= prevInput ? (prevInput.bulletType === "grenade" ? "selected" : "") : "" %>>Grenade Charges</option>
            <option value="special ammo"  <%= prevInput ? (prevInput.bulletType === "special ammo" ? "selected" : "") : "" %>>Special Charges/Ammo</option>
        </select>
        <label class="mag-size-label" for="mag-size">Mag Size: </label>
        <input id="mag-size" type="number" name="magSize" value="<%= prevInput ? prevInput.magSize : "" %>" min="0">
        <label class="damage-label" for="damage">Damage: </label>
        <input id="damage" type="number" name="damage" value="<%= prevInput ? prevInput.damage : "" %>" step="any" min="0">
        <label class="dps-label" for="dps">DPS: </label>
        <input id="dps" type="number" name="dps" value="<%= prevInput ? prevInput.dps : "" %>" step="any" min="0">
        <label class="crit-label" for="crit">Crit Damage: </label>
        <input id="crit" type="number" name="crit" value="<%= prevInput ? prevInput.crit : "" %>" step="any" min="0">
        <label class="fire-rate-label" for="fire-rate">Fire Rate: </label>
        <input id="fire-rate" type="number" name="fireRate" value="<%= prevInput ? prevInput.fireRate : "" %>" step="any" min="0">
        <label class="reload-time-label" for="reload-time">Reload Time: </label>
        <input id="reload-time" type="number" name="reloadTime" value="<%= prevInput ? prevInput.reloadTime : "" %>" step="any" min="0">
        <label class="img-link-label" for="img-link">Item Image Link: </label>
        <input id="img-link" type="text" name="imgLink" value="<%= prevInput ? prevInput.imgLink : "" %>">
        <button class="form-submit" type="submit">Submit</button>
    </form>