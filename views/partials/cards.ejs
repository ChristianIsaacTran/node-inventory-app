<head>
    <link rel="stylesheet" href="/cards.css">
</head>
<% let weaponsArr; %>
<% let conArr;  %>
<% let utilArr; %>
<% for(const [key, value] of Object.entries(records)) { %>
       <%  if(key === "weaponsRows") {  %>
       <%      weaponsArr = value;  %>
       <% } else if(key === "conRows") { %>
       <%      conArr = value;  %>
       <% }  else if(key === "utilRows") { %>
       <%     utilArr = value;  %>
       <% } else {  %>
       <%      throw new Error("Array not found.");  %>
       <% }  %>
<% } %>

<h1 class="group-title">Weapons <hr></h1>
<ul class="weapons-group">
<% weaponsArr.forEach((weapon) => { %>
    <li class="item-container weapon">
        <img src="<%= weapon.image_url%>" alt="weapon-image" class="<%= weapon.rarity  %>">
        <div class="item-info-group">
        <h2>Stock: <%= weapon.amount%></h2>
        <h4 class="card-rarity <%= weapon.rarity %>"><%= weapon.rarity%></h4>
        <h2><%= weapon.item_name%></h2>
        <h3><%= weapon.type%></h3>
            <div class="route-group">
                <a class="details-link" href="/details?name=<%=weapon.item_name%>&rarity=<%=weapon.rarity%>">DETAILS</button>
                <a class="delete-link" href="/delete?name=<%=weapon.item_name%>&rarity=<%=weapon.rarity%>" onclick="return confirm('Are you sure? The item will be deleted from the database.')">DELETE</a>
            </div>
        </div>
        

    </li>
<% }); %>
</ul>

<h1 class="group-title">Consumables <hr class="consumable-rule"></h1>
<ul class="consumables-group">
<% conArr.forEach((consumable) => { %>
    <li class="item-container consumable">
        <img src="<%= consumable.image_url%>" alt="consumable-image" class="<%= consumable.rarity  %>">
        <div class="item-info-group">
        <h2>Stock: <%= consumable.amount%></h2>
        <h4 class="card-rarity <%= consumable.rarity %>"><%= consumable.rarity%></h4>
        <h2><%= consumable.item_name%></h2>
        <h3><%= consumable.type%></h3>
            <div class="route-group">
                <a class="details-link" href="/details?name=<%=consumable.item_name%>&rarity=<%=consumable.rarity%>">DETAILS</button>
                <a class="delete-link" href="/delete?name=<%=consumable.item_name%>&rarity=<%=consumable.rarity%>" onclick="return confirm('Are you sure? The item will be deleted from the database.')">DELETE</a>
            </div>
        </div>
        

    </li>
<% }); %>
</ul>

<h1 class="group-title">Utilities <hr></h1>
<ul class="utilities-group">
<% utilArr.forEach((utility) => { %>
    <li class="item-container utility">
        <img src="<%= utility.image_url%>" alt="utility-image" class="<%= utility.rarity  %>">
        <div class="item-info-group">
        <h2>Stock: <%= utility.amount%></h2>
        <h4 class="card-rarity <%= utility.rarity %>"><%= utility.rarity%></h4>
        <h2><%= utility.item_name%></h2>
        <h3><%= utility.type%></h3>
            <div class="route-group">
                <a class="details-link" href="/details?name=<%=utility.item_name%>&rarity=<%=utility.rarity%>">DETAILS</button>
                <a class="delete-link" href="/delete?name=<%=utility.item_name%>&rarity=<%=utility.rarity%>" onclick="return confirm('Are you sure? The item will be deleted from the database.')">DELETE</a>
            </div>
        </div>
    </li>
<% }); %>
</ul>