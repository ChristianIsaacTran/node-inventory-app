<!-- weapon update form -->
<head>
    <link rel="stylesheet" href="/updateForm.css">
</head>
<% if (category === "weapon") { %>
    <form action="/update/<%=category%>/<%=category%>?name=<%=item.item_name %>&rarity=<%= item.rarity %>" method="post" class="weapon-update-form">
        <label class="amount-label" for="amount">Amount: </label>
        <input type="number" id="amount" name="amount" value="<%= item.amount %>">
        <label class="item-name-label" for="item-name ">Item name: </label>
        <input id="item-name" type="text" name="itemName" value="<%= item.item_name %>">
        <label class="item-category-label" for="item-category ">Item category: </label>
        <select id="item-category" name="itemCategory" value="<%= item.type %>">
            <option value="assault rifle">Assault Rifle</option>
            <option value="shotgun">Shotgun</option>
            <option value="submachine gun">Submachine Gun</option>
            <option value="pistol">Pistol</option>
            <option value="sniper rifle">Sniper Rifle</option>
            <option value="marksman rifle">Marksman Rifle</option>
            <option value="explosive weapon">Explosive Weapon</option>
            <option value="special weapon">Special Weapon</option>
        </select>
        <label class="item-rarity-label" for="item-rarity">Item rarity: </label>
        <select id="item-rarity" name="itemRarity" value="<%= item.rarity %>">
            <option value="common">Common</option>
            <option value="uncommon">Uncommon</option>
            <option value="rare">Rare</option>
            <option value="epic">Epic</option>
            <option value="legendary">Legendary</option>
            <option value="mythic">Mythic</option>
            <option value="exotic">Exotic</option>
        </select>
        <label class="bullet-type-label" for="bullet-type">Bullet Type: </label>
        <select id="bullet-type" name="bulletType" value="<%= item.bullet_type %>">
            <option value="light bullets">Light Bullets</option>
            <option value="medium bullets">Medium Bullets</option>
            <option value="heavy bullets">Heavy Bullets</option>
            <option value="shells">Shells</option>
            <option value="rockets">Rockets</option>
            <option value="arrows">Arrows</option>
            <option value="grenade">Grenade Charges</option>
            <option value="special ammo">Special Charges/Ammo</option>
        </select>
        <label class="mag-size-label" for="mag-size">Mag Size: </label>
        <input id="mag-size" type="number" name="magSize" value="<%= item.mag_size %>">
        <label class="damage-label" for="damage">Damage: </label>
        <input id="damage" type="number" name="damage" value="<%= item.damage %>" step="any">
        <label class="dps-label" for="dps">DPS: </label>
        <input id="dps" type="number" name="dps" value="<%= item.dps %>" step="any">
        <label class="crit-label" for="crit">Crit Damage: </label>
        <input id="crit" type="number" name="crit" value="<%= item.crit %>" step="any">
        <label class="fire-rate-label" for="fire-rate">Fire Rate: </label>
        <input id="fire-rate" type="number" name="fireRate" value="<%= item.fire_rate %>" step="any">
        <label class="reload-time-label" for="reload-time">Reload Time: </label>
        <input id="reload-time" type="number" name="reloadTime" value="<%= item.reload_time %>" step="any">
        <label class="img-link-label" for="img-link">Item Image Link: </label>
        <input id="img-link" type="text" name="imgLink" value="<%= item.image_url %>">
        <button class="form-submit" type="submit">Submit</button>
    </form>
<% } else if(category === "consumable") { %>
   <form action="/update/<%=category%>/<%=category%>?name=<%=item.item_name %>&rarity=<%= item.rarity %>" method="post" class="consumable-update-form">
        <label class="amount-label" for="amount">Amount: </label>
        <input type="number" id="amount" name="amount" value="<%= item.amount %>">
        <label class="item-name-label" for="item-name">Item name: </label>
        <input id="item-name" type="text" name="itemName" value="<%= item.item_name %>">
        <label class="item-category-label" for="item-category">Item category: </label>
        <select id="item-category" name="itemCategory" value="<%= item.type %>">
            <option value="consumable">Consumable</option>
        </select>
        <label class="item-rarity-label" for="item-rarity">Item rarity: </label>
        <select id="item-rarity" name="itemRarity" value="<%= item.rarity %>">
            <option value="common">Common</option>
            <option value="uncommon">Uncommon</option>
            <option value="rare">Rare</option>
            <option value="epic">Epic</option>
            <option value="legendary">Legendary</option>
            <option value="mythic">Mythic</option>
            <option value="exotic">Exotic</option>
        </select>
        <label class="heal-amount-label" for="heal-amount">Heal Amount: </label>
        <input id="heal-amount" type="number" name="healAmount" value="<%= item.heal_amount %>" step="any">
        <label class="shield-amount-label" for="shield-amount">Shield Amount: </label>
        <input id="shield-amount" type="number" name="shieldAmount" value="<%= item.shield_amount %>" step="any">
        <label class="effect-label" for="effect">Item Effect: </label>        
        <input id="effect" type="text" name="effect" value="<%= item.effect %>">
        <label class="img-link-label" for="img-link">Item Image Link: </label>
        <input id="img-link" type="text" name="imgLink" value="<%= item.image_url %>">
        <button class="form-submit" type="submit">Submit</button>
    </form>
<% } else if(category === "utility") { %>
    <form action="/update/<%=category%>/<%=category%>?name=<%=item.item_name %>&rarity=<%= item.rarity %>" method="post" class="utility-update-form">
        <label class="amount-label" for="amount">Amount: </label>
        <input type="number" id="amount" name="amount" value="<%= item.amount %>">
        <label class="item-name-label" for="item-name">Item name: </label>
        <input id="item-name" type="text" name="itemName" value="<%= item.item_name %>">
        <label class="item-category-label" for="item-category">Item category: </label>
        <select id="item-category" name="itemCategory" value="<%= item.type %>">
            <option value="utility">utility</option>
        </select>
        <label class="item-rarity-label" for="item-rarity">Item rarity: </label>
        <select id="item-rarity" name="itemRarity" value="<%= item.rarity %>">
            <option value="common">Common</option>
            <option value="uncommon">Uncommon</option>
            <option value="rare">Rare</option>
            <option value="epic">Epic</option>
            <option value="legendary">Legendary</option>
            <option value="mythic">Mythic</option>
            <option value="exotic">Exotic</option>
        </select>
        <label class="max-stacks-label" for="max-stacks">Max Stacks: </label>
        <input id="max-stacks" type="number" name="maxStacks" value="<%= item.max_stack %>">
        <label class="desription-label" for="description">Item Description: </label>
        <textarea id="description" rows="7" spellcheck name="description"><%= item.item_description %></textarea>
        <label class="img-link-label" for="img-link">Item Image Link: </label>
        <input id="img-link" type="text" name="imgLink" value="<%= item.image_url %>">
        <button class="form-submit" type="submit">Submit</button>
    </form>
<% } else {%>
    <h1>Error: item category not found.</h1>
<% } %>