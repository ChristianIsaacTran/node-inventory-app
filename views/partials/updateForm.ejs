<!-- weapon update form -->
<head>
    <link rel="stylesheet" href="/updateForm.css">
</head>
<% if (category === "weapon") { %>
    <form action="/update/<%=category%>/<%=category%>?name=<%=item.item_name %>&rarity=<%= item.rarity %>" method="post" class="weapon-update-form">
        <label class="amount-label" for="amount">Amount: </label>
        <input type="number" id="amount" name="amount" value="<%= item.amount %>" min="0">
        <label class="item-name-label" for="item-name ">Item name: </label>
        <input id="item-name" type="text" name="itemName" value="<%= item.item_name %>">
        <label class="item-category-label" for="item-category ">Item category: </label>
        <select id="item-category" name="itemCategory" value="<%= item.type %>">
            <option value="assault rifle" <%= item.type === "assault rifle" ? "selected" : "" %> >Assault Rifle</option>
            <option value="shotgun" <%= item.type === "shotgun" ? "selected" : "" %>>Shotgun</option>
            <option value="submachine gun" <%= item.type === "submachine gun" ? "selected" : "" %>>Submachine Gun</option>
            <option value="pistol" <%= item.type === "pistol" ? "selected" : "" %>>Pistol</option>
            <option value="sniper rifle" <%= item.type === "sniper rifle" ? "selected" : "" %>>Sniper Rifle</option>
            <option value="marksman rifle" <%= item.type === "marksman rifle" ? "selected" : "" %>>Marksman Rifle</option>
            <option value="explosive weapon" <%= item.type === "explosive weapon" ? "selected" : "" %>>Explosive Weapon</option>
            <option value="special weapon" <%= item.type === "special weapon" ? "selected" : "" %>>Special Weapon</option>
        </select>
        <label class="item-rarity-label" for="item-rarity">Item rarity: </label>
        <select id="item-rarity" name="itemRarity" >
            <option value="common" <%= item.rarity === "common" ? "selected" : "" %> >Common</option>
            <option value="uncommon" <%= item.rarity === "uncommon" ? "selected" : "" %>>Uncommon</option>
            <option value="rare" <%= item.rarity === "rare" ? "selected" : "" %>>Rare</option>
            <option value="epic" <%= item.rarity === "epic" ? "selected" : "" %>>Epic</option>
            <option value="legendary" <%= item.rarity === "legendary" ? "selected" : "" %>>Legendary</option>
            <option value="mythic" <%= item.rarity === "mythic" ? "selected" : "" %>>Mythic</option>
            <option value="exotic" <%= item.rarity === "exotic" ? "selected" : "" %>>Exotic</option>
        </select>
        <label class="bullet-type-label" for="bullet-type">Bullet Type: </label>
        <select id="bullet-type" name="bulletType" value="<%= item.bullet_type %>">
            <option value="light bullets" <%= item.bullet_type === "light bullets" ? "selected" : ""  %>>Light Bullets</option>
            <option value="medium bullets" <%= item.bullet_type === "medium bullets" ? "selected" : ""  %>>Medium Bullets</option>
            <option value="heavy bullets" <%= item.bullet_type === "heavy bullets" ? "selected" : ""  %>>Heavy Bullets</option>
            <option value="shells" <%= item.bullet_type === "shells" ? "selected" : ""  %>>Shells</option>
            <option value="rockets" <%= item.bullet_type === "rockets" ? "selected" : ""  %>>Rockets</option>
            <option value="arrows" <%= item.bullet_type === "arrows" ? "selected" : ""  %>>Arrows</option>
            <option value="grenade" <%= item.bullet_type === "grenade" ? "selected" : ""  %>>Grenade Charges</option>
            <option value="special ammo" <%= item.bullet_type === "charges" ? "selected" : ""  %>>Special Charges/Ammo</option>
        </select>
        <label class="mag-size-label" for="mag-size">Mag Size: </label>
        <input id="mag-size" type="number" name="magSize" value="<%= item.mag_size %>" min="0">
        <label class="damage-label" for="damage">Damage: </label>
        <input id="damage" type="number" name="damage" value="<%= item.damage %>" step="any" min="0">
        <label class="dps-label" for="dps">DPS: </label>
        <input id="dps" type="number" name="dps" value="<%= item.dps %>" step="any" min="0">
        <label class="crit-label" for="crit">Crit Damage: </label>
        <input id="crit" type="number" name="crit" value="<%= item.crit %>" step="any" min="0">
        <label class="fire-rate-label" for="fire-rate">Fire Rate: </label>
        <input id="fire-rate" type="number" name="fireRate" value="<%= item.fire_rate %>" step="any" min="0">
        <label class="reload-time-label" for="reload-time">Reload Time: </label>
        <input id="reload-time" type="number" name="reloadTime" value="<%= item.reload_time %>" step="any" min="0">
        <label class="img-link-label" for="img-link">Item Image Link: </label>
        <input id="img-link" type="text" name="imgLink" value="<%= item.image_url %>">
        <button class="form-submit" type="submit">Submit</button>
    </form>
<% } else if(category === "consumable") { %>
   <form action="/update/<%=category%>/<%=category%>?name=<%=item.item_name %>&rarity=<%= item.rarity %>" method="post" class="consumable-update-form">
        <label class="amount-label" for="amount">Amount: </label>
        <input type="number" id="amount" name="amount" value="<%= item.amount %>" min="0">
        <label class="item-name-label" for="item-name">Item name: </label>
        <input id="item-name" type="text" name="itemName" value="<%= item.item_name %>">
        <label class="item-category-label" for="item-category">Item category: </label>
        <select id="item-category" name="itemCategory">
            <option value="consumable" selected>Consumable</option>
        </select>
        <label class="item-rarity-label" for="item-rarity">Item rarity: </label>
        <select id="item-rarity" name="itemRarity" >
            <option value="common" <%= item.rarity === "common" ? "selected" : "" %> >Common</option>
            <option value="uncommon" <%= item.rarity === "uncommon" ? "selected" : "" %>>Uncommon</option>
            <option value="rare" <%= item.rarity === "rare" ? "selected" : "" %>>Rare</option>
            <option value="epic" <%= item.rarity === "epic" ? "selected" : "" %>>Epic</option>
            <option value="legendary" <%= item.rarity === "legendary" ? "selected" : "" %>>Legendary</option>
            <option value="mythic" <%= item.rarity === "mythic" ? "selected" : "" %>>Mythic</option>
            <option value="exotic" <%= item.rarity === "exotic" ? "selected" : "" %>>Exotic</option>
        </select>
        <label class="heal-amount-label" for="heal-amount">Heal Amount: </label>
        <input id="heal-amount" type="number" name="healAmount" value="<%= item.heal_amount %>" step="any" min="0">
        <label class="shield-amount-label" for="shield-amount">Shield Amount: </label>
        <input id="shield-amount" type="number" name="shieldAmount" value="<%= item.shield_amount %>" step="any" min="0">
        <label class="effect-label" for="effect">Item Effect: </label>        
        <input id="effect" type="text" name="effect" value="<%= item.effect %>">
        <label class="img-link-label" for="img-link">Item Image Link: </label>
        <input id="img-link" type="text" name="imgLink" value="<%= item.image_url %>">
        <button class="form-submit" type="submit">Submit</button>
    </form>
<% } else if(category === "utility") { %>
    <form action="/update/<%=category%>/<%=category%>?name=<%=item.item_name %>&rarity=<%= item.rarity %>" method="post" class="utility-update-form">
        <label class="amount-label" for="amount">Amount: </label>
        <input type="number" id="amount" name="amount" value="<%= item.amount %>" min="0">
        <label class="item-name-label" for="item-name">Item name: </label>
        <input id="item-name" type="text" name="itemName" value="<%= item.item_name %>">
        <label class="item-category-label" for="item-category">Item category: </label>
        <select id="item-category" name="itemCategory">
            <option value="utility" selected>utility</option>
        </select>
        <label class="item-rarity-label" for="item-rarity">Item rarity: </label>
        <select id="item-rarity" name="itemRarity" >
            <option value="common" <%= item.rarity === "common" ? "selected" : "" %> >Common</option>
            <option value="uncommon" <%= item.rarity === "uncommon" ? "selected" : "" %>>Uncommon</option>
            <option value="rare" <%= item.rarity === "rare" ? "selected" : "" %>>Rare</option>
            <option value="epic" <%= item.rarity === "epic" ? "selected" : "" %>>Epic</option>
            <option value="legendary" <%= item.rarity === "legendary" ? "selected" : "" %>>Legendary</option>
            <option value="mythic" <%= item.rarity === "mythic" ? "selected" : "" %>>Mythic</option>
            <option value="exotic" <%= item.rarity === "exotic" ? "selected" : "" %>>Exotic</option>
        </select>
        <label class="max-stacks-label" for="max-stacks">Max Stacks: </label>
        <input id="max-stacks" type="number" name="maxStacks" value="<%= item.max_stack %>" min="0">
        <label class="desription-label" for="description">Item Description: </label>
        <textarea id="description" rows="7" spellcheck name="description"><%= item.item_description %></textarea>
        <label class="img-link-label" for="img-link">Item Image Link: </label>
        <input id="img-link" type="text" name="imgLink" value="<%= item.image_url %>">
        <button class="form-submit" type="submit">Submit</button>
    </form>
<% } else {%>
    <h1>Error: item category not found.</h1>
<% } %>